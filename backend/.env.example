# FastAPI settings (env prefix IREVAL_). Copy to .env and adjust as needed.
IREVAL_DATABASE_URL=postgresql://ir@127.0.0.1:5432/ireval
IREVAL_OPENSEARCH_HOSTS=http://127.0.0.1:9200
IREVAL_MAX_FETCH=100
IREVAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: serve a built frontend from FastAPI
# IREVAL_FRONTEND_DIST=../frontend/dist
